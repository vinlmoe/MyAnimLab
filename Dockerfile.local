FROM php:8.2-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip libzip-dev \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install mysqli zip \
    && a2enmod rewrite \
    && printf '<Directory /var/www/html>\n    AllowOverride All\n</Directory>\n' > /etc/apache2/conf-available/myanimlab.conf \
    && a2enconf myanimlab

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY docker/local-entrypoint.sh /usr/local/bin/myvivarium-entrypoint

RUN chmod +x /usr/local/bin/myvivarium-entrypoint

WORKDIR /var/www/html
ENTRYPOINT ["myvivarium-entrypoint"]
CMD ["apache2-foreground"]
